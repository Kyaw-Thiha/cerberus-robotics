<?xml version="1.0"?>
<package format="3">
  <name>vikit_common</name>
  <version>0.0.0</version>

  <description>The vikit_common package (patched for ament_cmake vendoring under gs-livo)</description>

  <maintainer email="forster@ifi.uzh.ch">cforster</maintainer>
  <license>GPLv3</license>

  <!-- Buildtool: ament_cmake only (no catkin; gs-livo is ROS2-only). -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build dependencies on system / ament packages actually required by
       vikit_common/CMakeLists.txt. The upstream version's rclcpp + cmake_modules
       entries were catkin-era carryover with no actual use here, and they
       have been dropped. -->
  <depend>eigen</depend>
  <depend>libopencv-dev</depend>
  <depend>libfmt-dev</depend>
  <depend>libsophus-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
